<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Both current LTS releases. -->
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Ship XML docs in the package (IntelliSense). -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!-- GeneratePackageOnBuild removed: with multi-targeting it makes 'dotnet pack' fail (NU5026).
		     Build the package with: dotnet pack -c Release -->
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MathNet.Numerics" Version="5.0.0" />
	</ItemGroup>

	<PropertyGroup>
		<!-- NuGet metadata -->
		<PackageId>LinearRegression.Pvalues</PackageId>
		<Version>1.3.0</Version>
		<Authors>Jillian England</Authors>
		<Company>Hyperfaceted</Company>
		<Copyright>Copyright © Jillian England 2001–2026</Copyright>
		<Description>Lightweight bivariate (x, y) linear regression for .NET: slope, intercept, correlation, R², slope p-value, confidence intervals, margin of error, and experimental Benjamini-Hochberg q-values. Lineage from 1978 TI-58/59 calculator algorithms.</Description>
		<PackageTags>regression;linear-regression;statistics;p-value;confidence-interval;fdr;q-value;dotnet</PackageTags>
		<PackageProjectUrl>https://github.com/NinerXrayBravoTwoTwo/linear-regression-pvalues</PackageProjectUrl>
		<RepositoryUrl>https://github.com/NinerXrayBravoTwoTwo/linear-regression-pvalues</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<!-- Matches LICENSE (GNU AGPL v3); "or later" per Jill, 2026-11-20. Was LGPL-3.0-or-later. -->
		<PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
		<PackageReleaseNotes>1.3.0: new API, no breaking changes. Intercept inference: InterceptStandardError, InterceptPValue, InterceptConfidenceInterval (df = n - 2, Excel LINEST). Opt-in population (N) variance and standard deviation: VarianceXPopulation, VarianceYPopulation, StdDevXPopulation, StdDevYPopulation (Excel VAR.P/STDEV.P); defaults stay n - 1. Fixed: tiny p-values no longer round to 0 (2*CDF(-|t|)); Dec after removing a far-away point now restores the statistics (double-double streaming sums). XML docs for every public member. Full notes: https://github.com/NinerXrayBravoTwoTwo/linear-regression-pvalues/blob/main/CHANGELOG.md</PackageReleaseNotes>
		<IncludeSymbols>true</IncludeSymbols>
		<!-- Modern symbol package format -->
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
	</PropertyGroup>

	<PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
